# Frontend (Publicas y protegidas mediante Row Level Security en PostgreSQL)
VITE_SUPABASE_URL=https://su-proyecto-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_APP_ENV=development

# Backend / Netlify Functions (Privadas - Solo accesibles en servidor)
SUPABASE_URL=https://su-proyecto-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
RESEND_API_KEY=re_123456789_su_clave_secreta_de_correo
EMAIL_FROM_ADDRESS=notificaciones@planificaciondocente.cl
